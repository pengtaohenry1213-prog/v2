#!/bin/sh

# ================================================
# 受保护目录列表（硬编码，不从 .gitattributes 读取，避免自引用陷阱）
# ================================================
PROTECTED_DIRS=".cursor"

# ================================================
# 跳过检查的目录（钩子自身和 Git 系统文件）
# ================================================
SKIP_DIRS=".githooks"

# 检查一个文件是否在跳过目录中
is_skip() {
    local file="$1"
    for skip in $SKIP_DIRS; do
        case "$file" in
            $skip|$skip/*) return 0 ;;
        esac
    done
    return 1
}

# 检查一个文件是否在受保护目录中
is_protected() {
    local file="$1"
    for dir in $PROTECTED_DIRS; do
        case "$file" in
            $dir|$dir/*) return 0 ;;
        esac
    done
    return 1
}

# 合并所有变更文件（暂存区 + 工作区 + 未跟踪）
ALL_FILES=$(git diff --cached --name-only; git diff --name-only; git ls-files --others --exclude-standard)

BLOCKED_FILES=""

for file in $ALL_FILES; do
    if is_skip "$file"; then
        continue
    fi
    if is_protected "$file"; then
        BLOCKED_FILES="${BLOCKED_FILES}  - ${file}
"
    fi
done

if [ -n "$BLOCKED_FILES" ]; then
    echo "❌ 提交被拒绝: 以下文件匹配受保护规则"
    echo ""
    echo -e "$BLOCKED_FILES"
    echo "如需强制提交，请联系仓库管理员或使用 git commit --no-verify"
    exit 1
fi

echo "✅ protected 规则检查通过"
