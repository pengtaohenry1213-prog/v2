#!/bin/sh

# 获取即将提交的内容中涉及 .cursor 目录的文件变更
changed_cursor_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(\.cursor|/\.cursor)')

if [ -n "$changed_cursor_files" ]; then
    echo "❌ 提交被拒绝: 禁止提交 .cursor 目录的任何变更"
    echo ""
    echo "被拒绝的文件变更:"
    echo "$changed_cursor_files"
    exit 1
fi
